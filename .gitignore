# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# ignore any directory named temp at any depth
# **/temp/
**/output/
**/STLoutput/
**/.vscode/

# ignore all directories with the name temp including their files
temp/
*build/
*vtune*/
*hpctoolkit*/
*.hpcstruct


# vtk
*.vti
*.vtm
*.pvd
*.vtk
*.vtu

# dat
*.dat
*.json
#build/

# geometry
*.FCStd
# *.STL
*.FCBak
# *.stl
# voxel geometry masks are rebuilt from the casegen .geo recipe
*.flbgeo
# cse-generated unrolled-for specializations (shadow copies)
/generated/

# cse tool build artifacts
tools/cse/csegen
tools/cse/out/
__pycache__/

# velocity-field comparison dumps (solver run outputs)
benchmarks/cavity3d/profile_cpu.txt
benchmarks/cavity3d_cu/profile_gpu.txt

# checkpoint / restart output
**/ckpt/
ckpt/

# cross-decomposition checkpoint test output
**/ckpt_decomp/
**/child_spawn.log


# tools/geometry_build is a source tool; the *build/ rule above hides it
!tools/geometry_build/
!tools/geometry_build/Makefile
!tools/geometry_build/*.cpp
