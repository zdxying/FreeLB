# cavity2d_mpi: Phase P1 acceptance case for MPI emission.
#
# The same 32x32 lid-driven cavity as cavity2d, but auto-decomposed and built
# with mpic++ / -DMPI_ENABLED.  A decomposed run has overlap cells that exist
# on more than one rank, so the checksum reads only each block's interior
# (overlap .. N - overlap) and reduces the per-rank sums with MPI_SUM/MPI_MAX.
# The MPI expectations are measured with `mpirun -np 1` and must not move
# under `mpirun -np 2`.

[case]
name = cavity2d_mpi
dim = 2
float = double
latset = D2Q9
mpi = 1

[fields]
list = RHO, VELOCITY, POP

[flags]
void = 1
bulk = 2
wall = 4
moving_wall = 8

[grid]
n = 32, 32
cell_len = 1
block_cell_len = 10
thread_num = 1
decompose = auto

[physics]
converter = simplified
char_u = 0.1
rt = 0.56
rho_init = 1
init_u = 0, 0

[region.cavity]
shape = aabb
box = 0, 0, 32, 32
action = paint
flag = bulk

[region.walls]
shape = aabb
box = 0, 0, 32, 32
action = boundary
flag = wall

[region.lid]
shape = aabb
box = 1, 31, 31, 32
action = paint
flag = moving_wall
only_if = wall

[region.lid_velocity]
shape = aabb
box = 1, 31, 31, 32
action = set_velocity
flag = moving_wall
value = 0.1, 0

[tasks]
bulk = bgk
wall = normal
moving_wall = movingwall

[schedule]
type = hidden
steps = 200
output_step = 200
tol = 0
checkpoint_step = 0
restart = 0
restart_dir = ./ckpt

[output]
writers = rho, velocity
flag_writer = 0

[checksum]
enable = 1
expect_pop_mpi = 445.51566903028549
expect_rho_mpi = 1023.9878563745673
tol = 1e-12
