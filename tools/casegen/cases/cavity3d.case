# cavity3d: Phase 3 acceptance case for tools/casegen.
#
# Single-block 16x16x16 D3Q19 lid-driven cavity, 100 steps, tol = 0.  The
# geometry mirrors examples/cavity3d: the full box is painted bulk, the
# one-cell shell is bounce-back, and the top z layer (x,y inside the shell) is
# a moving wall with the lid velocity.  POP/RHO sumsq are the measured values
# of this exact configuration and pin the 3D numerical layout.

[case]
name = cavity3d
dim = 3
float = double
latset = D3Q19

[fields]
list = RHO, VELOCITY, POP

[flags]
void = 1
bulk = 2
wall = 4
moving_wall = 8

[grid]
n = 16, 16, 16
cell_len = 1
block_cell_len = 10
thread_num = 1
decompose = single

[physics]
converter = simplified
char_u = 0.1
rt = 0.56
rho_init = 1
init_u = 0, 0, 0

[region.cavity]
shape = aabb
box = 0, 0, 0, 16, 16, 16
action = paint
flag = bulk

[region.walls]
shape = aabb
box = 0, 0, 0, 16, 16, 16
action = boundary
flag = wall

[region.lid]
shape = aabb
box = 1, 1, 15, 15, 15, 16
action = paint
flag = moving_wall
only_if = wall

[region.lid_velocity]
shape = aabb
box = 1, 1, 15, 15, 15, 16
action = set_velocity
flag = moving_wall
value = 0.1, 0, 0

[tasks]
bulk = bgk
wall = normal
moving_wall = movingwall

[schedule]
type = hidden
steps = 100
output_step = 100
tol = 0
checkpoint_step = 0
restart = 0
restart_dir = ./ckpt

[output]
writers = rho, velocity
flag_writer = 0

[checksum]
enable = 1
expect_pop = 1327.451851
expect_rho = 5831.917013
tol = 1e-6
