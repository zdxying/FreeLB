# cavity3d_cu: Phase 3 3D CUDA acceptance case for tools/casegen.
#
# Same geometry, boundary layout, step count and collision as cavity3d.case,
# but a float build and [case] cuda = 1, so the generator emits <name>.cu and
# a Makefile whose first column is `CXXC := nvcc`.
#
# The pinned RHO sumsq is the value the generated CPU build (same spec with
# cuda = 0 and float) produces for this exact configuration: 16x16x16, 100
# steps, tol = 0, simplified(0.1, 0.56), D3Q19.  The device run has to agree
# with it to 1e-5 relative, so a wrong device field, a stale host copy or a
# mismatched kernel layout fails the case.
#
# POP is not pinned: the distribution container is a CyclicArray, which stores
# the populations rotated, and rotation changes the order of the host
# accumulation.  The sum and sumsq are permutation-invariant, but the last
# digits are not, which is below 1e-5 -- see docs/CASEGEN_PLAN.md.

[case]
name = cavity3d_cu
dim = 3
float = float
cuda = 1
latset = D3Q19

[fields]
list = RHO, VELOCITY, POP

[flags]
void = 1
bulk = 2
wall = 4
moving_wall = 8

[grid]
n = 16, 16, 16
cell_len = 1
block_cell_len = 10
thread_num = 1
decompose = single

[physics]
converter = simplified
char_u = 0.1
rt = 0.56
rho_init = 1
init_u = 0, 0, 0

[region.cavity]
shape = aabb
box = 0, 0, 0, 16, 16, 16
action = paint
flag = bulk

[region.walls]
shape = aabb
box = 0, 0, 0, 16, 16, 16
action = boundary
flag = wall

[region.lid]
shape = aabb
box = 1, 1, 15, 15, 15, 16
action = paint
flag = moving_wall
only_if = wall

[region.lid_velocity]
shape = aabb
box = 1, 1, 15, 15, 15, 16
action = set_velocity
flag = moving_wall
value = 0.1, 0, 0

[tasks]
bulk = bgk
wall = normal
moving_wall = movingwall

[schedule]
type = hidden
steps = 100
output_step = 100
tol = 0
checkpoint_step = 0
restart = 0
restart_dir = ./ckpt

[output]
writers = rho, velocity
flag_writer = 0

[checksum]
enable = 1
expect_rho = 5831.932013
tol = 1e-5
