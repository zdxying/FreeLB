# cavity2d_force: Phase 3 catalogue case for the BGK+force collision.
#
# Same 32x32 lid-driven cavity as cavity2d.case, but the bulk collision is
# `bgk_force` and a small constant lattice-unit force is written into the
# FORCE field.  `[physics] force` is the lattice force per unit volume (no
# conversion exists); the value below only has to make the force term
# non-trivial so the POP/RHO checksums pin the Guo forcing path.
#
# 200 steps, tol = 0: short enough for the test suite, deterministic.
# The pinned checksums are the measured values of this exact configuration.

[case]
name = cavity2d_force
dim = 2
float = double
latset = D2Q9

[fields]
list = RHO, VELOCITY, POP, FORCE

[flags]
void = 1
bulk = 2
wall = 4
moving_wall = 8

[grid]
n = 32, 32
cell_len = 1
block_cell_len = 10
thread_num = 1
decompose = single

[physics]
converter = simplified
char_u = 0.1
rt = 0.56
rho_init = 1
init_u = 0, 0
force = 0.0001, 0

[region.cavity]
shape = aabb
box = 0, 0, 32, 32
action = paint
flag = bulk

[region.walls]
shape = aabb
box = 0, 0, 32, 32
action = boundary
flag = wall

[region.lid]
shape = aabb
box = 1, 31, 31, 32
action = paint
flag = moving_wall
only_if = wall

[region.lid_velocity]
shape = aabb
box = 1, 31, 31, 32
action = set_velocity
flag = moving_wall
value = 0.1, 0

[tasks]
bulk = bgk_force
wall = normal
moving_wall = movingwall

[schedule]
type = hidden
steps = 200
output_step = 200
tol = 0
checkpoint_step = 0
restart = 0
restart_dir = ./ckpt

[output]
writers = rho, velocity
flag_writer = 0

[checksum]
enable = 1
expect_pop = 586.5301684
expect_rho = 1155.983056
tol = 1e-6
