# cavity2d_cu: Phase 3 CUDA acceptance case for tools/casegen.
#
# Same geometry and boundary layout as cavity2d.case, but a float build, 200
# steps and [case] cuda = 1, so the generator emits <name>.cu and a Makefile
# whose first column is `CXXC := nvcc`.
#
# The pinned RHO sumsq is the value the generated CPU build produces for this
# exact configuration (32x32, 200 steps, tol = 0, simplified(0.1, 0.56),
# float).  The device run has to agree with it to 1e-5 relative, so a wrong
# device field, a stale host copy or a misaligned POP window fails the case.
#
# POP is not pinned: the distribution container is a CyclicArray, which stores
# the populations rotated, and rotation changes the order of the host
# accumulation.  The sum and sumsq are permutation-invariant, but the last
# digits are not, which is below 1e-5 -- see tools/casegen/DESIGN.md.

[case]
name = cavity2d_cu
dim = 2
float = float
cuda = 1
latset = D2Q9

[fields]
list = RHO, VELOCITY, POP

[flags]
void = 1
bulk = 2
wall = 4
moving_wall = 8

[grid]
n = 32, 32
cell_len = 1
block_cell_len = 10
thread_num = 1
decompose = single

[physics]
converter = simplified
char_u = 0.1
rt = 0.56
rho_init = 1
init_u = 0, 0

[region.cavity]
shape = aabb
box = 0, 0, 32, 32
action = paint
flag = bulk

[region.walls]
shape = aabb
box = 0, 0, 32, 32
action = boundary
flag = wall

[region.lid]
shape = aabb
box = 1, 31, 31, 32
action = paint
flag = moving_wall
only_if = wall

[region.lid_velocity]
shape = aabb
box = 1, 31, 31, 32
action = set_velocity
flag = moving_wall
value = 0.1, 0

[tasks]
bulk = bgk
wall = normal
moving_wall = movingwall

[schedule]
type = hidden
steps = 200
output_step = 200
tol = 0
checkpoint_step = 0
restart = 0
restart_dir = ./ckpt

[output]
writers = rho, velocity
flag_writer = 0

[checksum]
enable = 1
expect_rho = 1155.992025
tol = 1e-5
