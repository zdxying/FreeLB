# couette2d_plain: Phase 3 acceptance case for the plain schedule and the
# periodic boundary.
#
# Couette flow between a fixed bottom wall and a moving top lid, periodic in x
# (examples/couette2d).  The plain schedule runs the bounce-back through
# BBLikeFixedBlockBdManager instead of hidden-communication collision tasks,
# and `periodic = x` adds FixedPeriodicBoundaryManager:
#
#   RhoU -> collision -> NS_Peri.Apply -> Stream
#        -> BlockBoundaryManager::Apply -> Communicate
#
# The periodic face strips are painted only over the wall shell (y = 1..30),
# so the bottom row stays `wall` and the top row stays `moving_wall`.
# 32x32, 200 steps, tol = 0; the pinned checksums are measured values.

[case]
name = couette2d_plain
dim = 2
float = double
latset = D2Q9

[fields]
list = RHO, VELOCITY, POP

[flags]
void = 1
bulk = 2
wall = 4
moving_wall = 8
periodic = 16

[grid]
n = 32, 32
cell_len = 1
block_cell_len = 10
thread_num = 1
decompose = single

[physics]
converter = simplified
char_u = 0.1
rt = 0.56
rho_init = 1
init_u = 0, 0

[region.cavity]
shape = aabb
box = 0, 0, 32, 32
action = paint
flag = bulk

[region.walls]
shape = aabb
box = 0, 0, 32, 32
action = boundary
flag = wall

[region.lid]
shape = aabb
box = 0, 31, 32, 32
action = paint
flag = moving_wall
only_if = wall

[region.lid_velocity]
shape = aabb
box = 0, 31, 32, 32
action = set_velocity
flag = moving_wall
value = 0.1, 0

[region.sides_left]
shape = aabb
box = 0, 1, 1, 31
action = paint
flag = periodic
only_if = wall

[region.sides_right]
shape = aabb
box = 31, 1, 32, 31
action = paint
flag = periodic
only_if = wall

[tasks]
bulk|periodic = bgk
wall = normal
moving_wall = movingwall

[schedule]
type = plain
periodic = x
steps = 200
output_step = 200
tol = 0
checkpoint_step = 0
restart = 0
restart_dir = ./ckpt

[output]
writers = rho, velocity
flag_writer = 0

[checksum]
enable = 1
expect_pop = 287.5573693
expect_rho = 1148.306514
tol = 1e-6
